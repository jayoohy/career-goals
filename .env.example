# Copy to .env.local for local dev, and set the same names in the Vercel project (task 7.1).

# Generate once with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact URL/mailto required by the Web Push protocol handshake — set to the deployed app URL.
VAPID_SUBJECT=

# Random token gating /api/subscribe and /api/log-sync. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both vars must hold the SAME value — server-only and client-embedded copies of one secret.
PUSH_SHARED_SECRET=
NEXT_PUBLIC_PUSH_SHARED_SECRET=

# From the Upstash console's REST API section, once the Redis database exists (task 5.2).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel auto-sends `Authorization: Bearer $CRON_SECRET` on Cron Job requests once this is set
# as a Vercel env var — verifies /api/cron/* requests actually came from Vercel Cron.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
